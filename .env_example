# ============================================================
#  Configurazione dei path (copia questo file in .env)
#  I path relativi sono riferiti alla radice del progetto.
#  I path assoluti (che iniziano con /) vengono usati cosi' come sono.
#  Se una variabile manca o e' vuota, si usa il valore predefinito
#  indicato in fondo a ogni riga.
# ============================================================

# Cartella delle note Obsidian (sorgente). Obbligatoria.
OBSIDIAN_NOTES_DIR="path/obsidian"

# Cartella dove build.sh crea i collegamenti alle note .md   [chapters_md]
MD_SOURCE_DIR="chapters_md"

# Cartella dei frammenti .tex generati da Pandoc             [chapters]
CHAPTERS_DIR="chapters"

# Cartella dei PDF finali (main-<formato>.pdf)               [pdf]
PDF_DIR="pdf"

# Cartella dei sorgenti e dei PDF dei diagrammi Mermaid      [mermaid]
MERMAID_DIR="mermaid"

# Cartella dei font (.ttf/.otf)                              [fonts]
FONTS_DIR="fonts"

# Cartella delle immagini                                    [Images]
IMAGES_DIR="Images"

# Cartella dei file della copertina (uni_logo.pdf)           [sources]
SOURCES_DIR="sources"

# File LaTeX principale compilato da build.sh                [main.tex]
MAIN_TEX="main.tex"
